rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Story media is public to view (the slideshow is shared by link),
    // but only the owner's verified Google account may upload, replace or delete.
    match /presentations/yan-story-teller-default/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null
        && request.auth.token.email == 'yasser159@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
